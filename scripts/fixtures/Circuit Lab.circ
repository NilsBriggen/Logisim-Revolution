<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="5.0.0" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="5"/>
  <lib desc="#I/O" name="6"/>
  <lib desc="#Base" name="9"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings><tool lib="9" map="Button2" name="Poke Tool"/><tool lib="9" map="Button3" name="Menu Tool"/></mappings>
  <toolbar><tool lib="9" name="Poke Tool"/><tool lib="9" name="Edit Tool"/><tool lib="9" name="Wiring Tool"/><tool lib="9" name="Text Tool"/><sep/><tool lib="0" name="Pin"/><tool lib="1" name="AND Gate"/></toolbar>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <comp lib="0" loc="(160,220)" name="Clock">
      <a name="label" val="clk"/>
    </comp>
    <comp lib="5" loc="(300,200)" name="Counter">
      <a name="appearance" val="classic"/>
      <a name="label" val="cnt"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="0" loc="(400,200)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="width" val="8"/>
      <a name="label" val="count"/>
      <a name="radix" val="16"/>
    </comp>
    <comp lib="0" loc="(400,300)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="clk_out"/>
    </comp>
    <comp lib="0" loc="(100,400)" name="Pin">
      <a name="label" val="a"/>
    </comp>
    <comp lib="1" loc="(200,400)" name="NOT Gate"/>
    <comp lib="0" loc="(300,400)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="y"/>
    </comp>
    <comp lib="5" loc="(600,100)" name="RAM">
      <a name="label" val="memory_ram"/>
    </comp>
    <comp lib="5" loc="(600,500)" name="ROM">
      <a name="label" val="memory_rom"/>
      <a name="contents">addr/data: 8 8
1 2 3 4 5 6 7 8 9 a b c d e f 10
ff fe fd 4*0 aa 55
</a>
    </comp>
    <wire from="(160,220)" to="(180,220)"/>
    <wire from="(180,220)" to="(280,220)"/>
    <wire from="(180,220)" to="(180,300)"/>
    <wire from="(180,300)" to="(400,300)"/>
    <wire from="(300,200)" to="(400,200)"/>
    <wire from="(100,400)" to="(170,400)"/>
    <wire from="(200,400)" to="(300,400)"/>
  </circuit>
  <circuit name="Counter">
    <a name="circuit" val="Counter"/>
    <comp lib="0" loc="(160,100)" name="Clock">
      <a name="label" val="subclk"/>
    </comp>
    <comp lib="5" loc="(300,80)" name="Counter">
      <a name="appearance" val="classic"/>
      <a name="label" val="subcnt"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(400,80)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="width" val="4"/>
      <a name="label" val="q"/>
    </comp>
    <comp lib="5" loc="(300,200)" name="Register">
      <a name="appearance" val="classic"/>
      <a name="label" val="reg"/>
    </comp>
    <wire from="(160,100)" to="(280,100)"/>
    <wire from="(300,80)" to="(400,80)"/>
  </circuit>
  <circuit name="Inverter">
    <a name="circuit" val="Inverter"/>
    <comp lib="0" loc="(100,100)" name="Pin">
      <a name="label" val="a"/>
    </comp>
    <comp lib="1" loc="(200,100)" name="NOT Gate"/>
    <comp lib="0" loc="(300,100)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="y"/>
    </comp>
    <wire from="(100,100)" to="(170,100)"/>
    <wire from="(200,100)" to="(300,100)"/>
  </circuit>
</project>
